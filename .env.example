# ==========================================
# Dark CRM - Environment Variables Configuration
# Copy this file to .env or .env.production and provide your secrets
# DO NOT COMMIT .env or .env.production to version control!
# ==========================================

# 1. Database Connection (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:5432/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname:5432/neondb?sslmode=require"

# 2. Authentication Secret (Min 32 characters, Cryptographically secure)
JWT_SECRET="generate_a_secure_random_base64_secret_here"

# 3. System Initial Setup Token (Required to access /api/setup)
SETUP_SECRET="generate_a_secure_token_for_setup_here"

# 4. Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_public_vapid_key"
VAPID_PRIVATE_KEY="your_private_vapid_key"
VAPID_SUBJECT="mailto:support@dark-crm.com"

# 5. Cloudflare R2 Storage (Optional for external custom bucket images)
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="dark-crm-images"
R2_PUBLIC_DOMAIN=""

# 6. Optional Integrations
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
