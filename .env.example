# ==========================================
# Dark CRM - Environment Variables Configuration
# Copy this file to .env or .env.production and provide your secrets
# DO NOT COMMIT .env or .env.production to version control!
# ==========================================

# 1. Database Connection (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:5432/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname:5432/neondb?sslmode=require"

# 2. Authentication Secret (Min 32 characters, Cryptographically secure)
JWT_SECRET="generate_a_secure_random_base64_secret_here"

# 3. System Initial Setup Token (Required to access /api/setup)
SETUP_SECRET="generate_a_secure_token_for_setup_here"

# 4. Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_public_vapid_key"
VAPID_PRIVATE_KEY="your_private_vapid_key"
VAPID_SUBJECT="mailto:support@dark-crm.com"

# 5. ImageKit Storage (Property & Unit Images)
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# 6. Test & Staging Database (Required for integration tests - DO NOT run tests on production Neon DB)
TEST_DATABASE_URL="postgresql://username:password@hostname:5432/neondb_test?sslmode=require"

# 7. Optional Integrations
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_GRAPH_VERSION=""
X_BEARER_TOKEN=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_API_VERSION=""
LINKEDIN_AD_ACCOUNT_ID=""
LINKEDIN_LEAD_FORM_ID=""
LINKEDIN_LEAD_FORM_REVISION=""
LINKEDIN_FIRST_NAME_QUESTION_ID=""
LINKEDIN_LAST_NAME_QUESTION_ID=""
LINKEDIN_PHONE_QUESTION_ID=""
LINKEDIN_EMAIL_QUESTION_ID=""
LINKEDIN_CONTACT_CONSENT_ID=""
