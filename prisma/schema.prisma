generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String         @id @default(uuid())
  name                  String
  email                 String         @unique
  password              String
  role                  String         @default("SALES_EMPLOYEE")
  phone                 String?
  nationalId            String?
  address               String?
  dateJoined            DateTime?
  salaryBase            Float?         @default(0)
  isActive              Boolean        @default(true)
  expertAreas           String?
  birthDate             DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankAccountDetails    String?
  qualification         String?
  experience            String?
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  profileCompleted      Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  auditLogs             AuditLog[]
  commissions           Commission[]
  customers             Customer[]     @relation("AssignedTo")
  deals                 Deal[]         @relation("SalesRep")
  interactions          Interaction[]
  notifications         Notification[]
  reminders             Reminder[]
}

model Project {
  id          String     @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  customers   Customer[]
}

model Customer {
  id                    String        @id @default(uuid())
  code                  String?       @unique
  name                  String
  phone                 String
  email                 String?
  type                  String        @default("SELLER")
  status                String        @default("POTENTIAL_SELLER")
  source                String?
  area                  String?
  propertyType          String?
  customData            Json?         @default("{}")
  governorate           String?
  city                  String?
  executingCompany      String?
  deliveryDate          String?
  floor                 String?
  bedrooms              Int?
  bathrooms             Int?
  finishing             String?
  unitSize              Float?
  preferencesSummary    String?
  unitStatus            String?
  isNegotiable          Boolean?      @default(false)
  viewingTimes          String?
  paperworkStatus       String?
  projectName           String?
  unitNumber            String?
  zoneNumber            String?
  buildingNumber        String?
  pipelineStage         String?
  customerType          String?
  askingPrice           Float?
  remainingInstallments Float?
  installmentDuration   Int?
  budgetMin             Float?        @default(0)
  budgetMax             Float?        @default(0)
  preferredZone         String?
  preferredSize         Float?        @default(0)
  lastInteractionAt     DateTime?
  installmentAmount     Float?        @default(0)
  installmentRemaining  Int?          @default(0)
  installmentDetails    String?
  isArchived            Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  projectId             String?
  assignedToId          String?
  leadScore             Int           @default(3)
  assignedTo            User?         @relation("AssignedTo", fields: [assignedToId], references: [id])
  project               Project?      @relation(fields: [projectId], references: [id])
  deals                 Deal[]
  interactions          Interaction[]
  reminders             Reminder[]
  propertyOwnerships    PropertyOwnership[]

  @@index([assignedToId])
  @@index([status])
  @@index([type])
  @@index([projectId])
  @@index([createdAt])
  @@index([phone])
  @@index([name])
  @@index([isArchived])
}

model Property {
  id                    String   @id @default(uuid())
  title                 String?
  projectName           String?
  unitNumber            String?
  buildingNumber        String?
  zone                  String?
  floor                 String?
  size                  Float?
  bedrooms              Int?
  bathrooms             Int?
  unitType              String?
  finishing             String?
  price                 Float?
  status                String   @default("AVAILABLE")
  description           String?
  images                String?
  monthlyInstallment    Float?
  remainingMonths       Int?
  installmentType       String?  @default("FIXED")
  installmentPercentage Float?
  customData            Json?    @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deals                 Deal[]
  ownerships            PropertyOwnership[]

  @@index([status, createdAt])
  @@index([projectName])
  @@index([zone])
}

model CustomFieldDefinition {
  id         String   @id @default(uuid())
  entityType String
  label      String
  name       String
  fieldType  String
  options    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Deal {
  id            String    @id @default(uuid())
  customerId    String
  propertyId    String?
  salesRepId    String?
  status        String
  value         Float
  commission    Float?
  commissionAmt Float?
  finalPrice    Float?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer  @relation(fields: [customerId], references: [id])
  property      Property? @relation(fields: [propertyId], references: [id])
  salesRep      User?     @relation("SalesRep", fields: [salesRepId], references: [id])

  @@index([salesRepId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Interaction {
  id         String   @id @default(uuid())
  customerId String
  userId     String
  type       String
  notes      String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
}

model Reminder {
  id         String   @id @default(uuid())
  userId     String?
  customerId String
  title      String
  dueDate    DateTime
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model Commission {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model SystemSettings {
  id                      String   @id @default("GLOBAL")
  kanbanEnabled           Boolean  @default(true)
  voiceSearchEnabled      Boolean  @default(true)
  smartLoggingEnabled     Boolean  @default(true)
  darkModeEnabled         Boolean  @default(true)
  bulkActionsEnabled      Boolean  @default(true)
  internalMentionsEnabled Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model FinancialTransaction {
  id          String   @id @default(uuid())
  type        String
  category    String
  amount      Float
  description String?
  status      String   @default("COMPLETED")
  date        DateTime @default(now())
  relatedId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([relatedId])
  @@index([type])
}

model PropertyOwnership {
  id              String    @id @default(uuid())
  propertyId      String
  customerId      String
  percentage      Float
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  isCurrent       Boolean   @default(true)
  notes           String?
  transferReason  String?
  previousOwnerId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([propertyId, isCurrent])
  @@index([customerId])
  @@index([effectiveFrom, effectiveTo])
}

model JobQueue {
  id          String    @id @default(uuid())
  type        String
  payload     Json      @default("{}")
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  lockedAt    DateTime?
  lockedBy    String?
  runAt       DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  claimToken String?    @unique

  @@index([status, runAt])
  @@index([lockedAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  link      String?
  dedupKey String?   @unique
  dedupAt  DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model PushDeliveryLog {
  id             String    @id @default(uuid())
  notificationId String?
  userId         String
  endpoint       String
  outcome        String    // PROVIDER_ACCEPTED, EXPIRED, FAILED, UNKNOWN, SKIPPED_NO_KEYS
  statusCode     Int?
  errorDetails   String?
  dispatchKey    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([dispatchKey, endpoint])
  @@index([userId])
  @@index([outcome])
  @@index([createdAt])
  @@index([dispatchKey])
}

