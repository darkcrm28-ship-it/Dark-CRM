generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("SALES_EMPLOYEE")
  phone         String?
  nationalId    String?
  address       String?
  dateJoined    DateTime?
  salaryBase    Float?    @default(0)
  isActive      Boolean   @default(true)
  expertAreas   String?   // Comma-separated areas of expertise
  
  // Employee Profile Fields
  birthDate             DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankAccountDetails    String?
  qualification         String?
  experience            String?
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  profileCompleted      Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customers     Customer[] @relation("AssignedTo")
  interactions  Interaction[]
  commissions   Commission[]
  auditLogs     AuditLog[]
  reminders     Reminder[]
  deals         Deal[]     @relation("SalesRep")
  notifications Notification[]
}

model Project {
  id          String     @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  customers   Customer[]
}

model Customer {
  id                    String        @id @default(uuid())
  code                  String?       @unique
  name                  String
  phone                 String
  email                 String?
  type                  String        @default("SELLER")
  status                String        @default("POTENTIAL_SELLER")
  source                String?
  area                  String?
  propertyType          String?       
  
  // Dynamic Custom Data
  customData            Json?         @default("{}")

  // New unified fields for Sellers (Units) and Buyers (Preferences)
  governorate           String?
  city                  String?
  executingCompany      String?
  deliveryDate          String?
  floor                 String?
  bedrooms              Int?
  bathrooms             Int?
  finishing             String?
  unitSize              Float?
  preferencesSummary    String?
  
  // New operational fields
  unitStatus            String?       // VACANT, RENTED, OCCUPIED, etc.
  isNegotiable          Boolean?      @default(false)
  viewingTimes          String?       // Available viewing times
  paperworkStatus       String?       // Details about paperwork status
  
  // Legacy fields to preserve data during migration
  projectName           String?       
  unitNumber            String?
  zoneNumber            String?
  buildingNumber        String?
  pipelineStage         String?
  customerType          String?
  askingPrice           Float?
  remainingInstallments Float?
  installmentDuration   Int?
  budgetMin             Float?        @default(0)
  budgetMax             Float?        @default(0)
  preferredZone         String?
  preferredSize         Float?        @default(0)
  lastInteractionAt     DateTime?

  // Installment Details
  installmentAmount     Float?        @default(0)
  installmentRemaining  Int?          @default(0)
  installmentDetails    String?
  
  isArchived            Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  projectId             String?
  project               Project?      @relation(fields: [projectId], references: [id])
  assignedToId          String?
  assignedTo            User?         @relation("AssignedTo", fields: [assignedToId], references: [id])
  leadScore             Int           @default(3)
  interactions          Interaction[]
  deals                 Deal[]
  reminders             Reminder[]

  @@index([assignedToId])
  @@index([status])
  @@index([type])
  @@index([projectId])
  @@index([createdAt])
  @@index([phone])
  @@index([name])
  @@index([isArchived])
}

model Property {
  id                    String   @id @default(uuid())
  title                 String?
  projectName           String?
  unitNumber            String?
  buildingNumber        String?
  zone                  String?
  floor                 String?
  size                  Float?
  bedrooms              Int?
  bathrooms             Int?
  unitType              String?
  finishing             String?
  price                 Float?
  status                String   @default("AVAILABLE")
  description           String?
  images                String?  
  monthlyInstallment    Float?
  remainingMonths       Int?
  installmentType       String?  @default("FIXED")
  installmentPercentage Float?

  // Dynamic Custom Data
  customData            Json?    @default("{}")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deals                 Deal[]
}

model CustomFieldDefinition {
  id          String   @id @default(uuid())
  entityType  String   // CUSTOMER, PROPERTY
  label       String   // Arabic Label
  name        String   // Field key in Json
  fieldType   String   // TEXT, NUMBER, DATE, SELECT
  options     String?  // Comma-separated options for SELECT
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deal {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id])
  salesRepId    String?
  salesRep      User?    @relation("SalesRep", fields: [salesRepId], references: [id])
  status        String   
  value         Float
  commission    Float?
  commissionAmt Float?
  finalPrice    Float?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Interaction {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String   
  notes         String
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
}

model Reminder {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  title         String
  dueDate       DateTime
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Commission {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amount        Float
  status        String   @default("PENDING")
  notes         String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  action        String
  entity        String
  entityId      String
  details       String?
  createdAt     DateTime @default(now())
}

model SystemSettings {
  id                String  @id @default("GLOBAL")
  kanbanEnabled     Boolean @default(true)
  voiceSearchEnabled Boolean @default(true)
  smartLoggingEnabled Boolean @default(true)
  darkModeEnabled    Boolean @default(true)
  bulkActionsEnabled Boolean @default(true)
  internalMentionsEnabled Boolean @default(true)
  updatedAt         DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model FinancialTransaction {
  id          String   @id @default(uuid())
  type        String   // INCOME, EXPENSE
  category    String   // SALARY, RENT, COMMISSION, REVENUE, OTHER_EXPENSE
  amount      Float
  description String?
  status      String   @default("COMPLETED") // PENDING, COMPLETED
  date        DateTime @default(now())
  
  // Link to other entities if applicable
  relatedId   String?  // Optional ID for deals, commissions, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
